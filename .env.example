# Required: Anthropic API key used for screenshot reading and reply generation
ANTHROPIC_API_KEY=

# Strongly recommended: shared team password (HTTP basic auth; any username works)
APP_PASSWORD=

# Optional
PORT=3000
# Where the SQLite database lives. Point this at a persistent volume in production.
DATA_DIR=./data
# Model and effort for generation (defaults shown)
CLAUDE_MODEL=claude-opus-5-5
GENERATION_EFFORT=medium
# How many Klaff source passages to retrieve per objection
CORPUS_EXCERPTS=6
