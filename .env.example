# --- LLM keys -------------------------------------------------------------
# OpenAI writes the three replies whenever OPENAI_API_KEY is set.
OPENAI_API_KEY=
# Optional. If set, Claude reads the screenshots; otherwise OpenAI does both steps.
ANTHROPIC_API_KEY=

# Override which provider handles each step: "openai" or "anthropic"
# GENERATION_PROVIDER=openai
# EXTRACTION_PROVIDER=anthropic

# OpenAI model (must support vision + structured outputs if it also reads screenshots)
OPENAI_MODEL=gpt-5
# Optional, reasoning models only: minimal | low | medium | high. Leave unset for gpt-4o-style models.
# OPENAI_REASONING_EFFORT=medium

# Claude settings (used only for steps on Claude)
CLAUDE_MODEL=claude-opus-5-5
GENERATION_EFFORT=medium

# --- App --------------------------------------------------------------------
# Everyone signs in with their own account. The owner (ADMIN_EMAIL) manages who
# has access at /admin. On first start the owner gets a one-time setup link in the
# server log; alternatively set ADMIN_PASSWORD to give the owner a first password.
ADMIN_EMAIL=mike@bluestonepartnersllc.com
# ADMIN_PASSWORD=
PORT=3000
# How many Klaff source passages to retrieve per objection
CORPUS_EXCERPTS=6

# --- Storage ----------------------------------------------------------------
# Postgres for all data (clients, chat turns, saved replies, corpus). Unset = SQLite in DATA_DIR.
# On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} (private URL, no SSL). Public proxy URLs get SSL automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Optional SSL override: disable | require | no-verify | verify-full
# PGSSLMODE=

# S3-compatible bucket for screenshots. Unset = files in DATA_DIR/uploads.
# These are the names Railway Buckets expose (reference them as ${{Bucket.BUCKET}} etc.).
# S3_BUCKET / S3_ENDPOINT / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION also work.
# BUCKET=
# ENDPOINT=https://t3.storageapi.dev
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
# REGION=auto
# Only for older buckets whose Credentials tab says to use path-style URLs:
# S3_FORCE_PATH_STYLE=true

# Local fallback for whatever isn't configured above (SQLite file + uploads/).
# Not needed when both DATABASE_URL and a bucket are set.
DATA_DIR=./data
